{
  "name": "smart-fish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:backend": "uv run uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 5001",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "uv run pytest -v",
    "lint": "uv run ruff check backend/",
    "format": "uv run ruff format backend/",
    "setup": "uv sync && cd frontend && npm install"
  }
}
